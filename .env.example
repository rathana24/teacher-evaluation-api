# PostgreSQL connection settings
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="teacher_evaluation"
DB_USER="postgres"
DB_PASSWORD="your_password"

# Optional full URL override for Prisma CLI commands and hosted databases
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/teacher_evaluation?schema=public"

# Use a long, random value in your local .env and production environment
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Optional: defaults to 3000 when omitted
PORT=3000

# Frontend rollout: keep legacy callers during integration, then require reviewed
# confirmations after callers use review_id. Deploy the additive migration first.
REQUIRE_REVIEWED_CONFIRMATION=false
