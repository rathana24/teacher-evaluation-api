# PostgreSQL connection settings
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="teacher_evaluation"
DB_USER="postgres"
DB_PASSWORD="your_password"

# Optional full URL override for Prisma CLI commands and hosted databases
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/teacher_evaluation?schema=public"

# Use a long, random value in your local .env and production environment
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Optional: defaults to 3000 when omitted
PORT=3000

# Allowed browser origins for CORS, comma-separated. Defaults to http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Cohort cutover (requirement E). When true, writes must use an explicit major-owned
# cohort (major_id + generation_number) and legacy label-only writes are rejected with
# MAJOR_SCOPED_COHORT_REQUIRED; /auth/me then advertises major_scoped_generations.
# Run npm run cohorts:preflight and review legacy mappings before enabling it.
REQUIRE_MAJOR_SCOPED_COHORTS=false

# Frontend rollout: keep legacy callers during integration, then require reviewed
# confirmations after callers use review_id. Deploy the additive migration first.
REQUIRE_REVIEWED_CONFIRMATION=false
