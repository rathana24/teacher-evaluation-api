# Copy to .env.test.local and enter your own local credentials.
# This database must already exist; the guarded test runner never resets it.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teacher_evaluation_test
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
DATABASE_URL="postgresql://postgres:replace-with-your-local-password@localhost:5432/teacher_evaluation_test?schema=public"
JWT_SECRET=replace-with-a-long-random-test-secret
JWT_EXPIRES_IN=1d
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
REQUIRE_REVIEWED_CONFIRMATION=false
